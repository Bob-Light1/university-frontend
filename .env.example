VITE_API_BASE_URL=http://localhost:5000/api
VITE_IMAGE_BASE_URL=http://localhost:5000
# Public marketing portal (Next.js). Legacy /register redirects to its /r/{CODE} short link.
VITE_PORTAL_URL=http://localhost:3000
# Public product identity (build-time; never put secrets in VITE_* variables).
VITE_BRAND_NAME=Wewigo
VITE_BRAND_LOGO_URL=
VITE_BRAND_ICON_URL=
# HTTPS booking/contact destination takes precedence over email. Empty = product tour.
VITE_SALES_URL=
VITE_SALES_EMAIL=
# Optional HTTPS destinations; unset links are not rendered.
VITE_PRIVACY_URL=
VITE_TERMS_URL=
